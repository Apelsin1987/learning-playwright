{
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@datafactory/*": ["lib/datafactory/*"],
      "@helpers/*": ["lib/helpers/*"],
      "@pages/*": ["lib/pages/*"],
      "@fixtures/*": ["lib/fixtures/*"],
    }
  },
  "include": [
    "tests/**/*.ts",
    "lib/**/*.ts",
    "playwright.config.ts",
    "global.d.ts"
  ]
}
